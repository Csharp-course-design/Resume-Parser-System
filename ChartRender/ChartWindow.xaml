<Window x:Class="ChartRender.ChartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="clr-namespace:OxyPlot.Wpf;assembly=OxyPlot.Wpf"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="MainWindow" Height="1000" Width="1600"
        WindowStyle="None"
        Background="#3e3a65"
        AllowsTransparency="True"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <Border Background="#3e3a65" CornerRadius="15" ClipToBounds="True">

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">

                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <oxy:PlotView Name="DegreePieChartPlotView" Background="Transparent" Height="400" Width="560"
                                  Margin="20" />

                    <oxy:PlotView Name="AgePieChartPlotView" Background="Transparent" Height="400" Width="560"
                                  Margin="20" />
                </StackPanel>

                <oxy:PlotView Name="SkillBarChartPlotView" Background="Transparent" Height="900" Width="900" />

            </StackPanel>

        </Border>

        <Grid>
            <materialDesign:PackIcon Kind="WindowMinimize"
                                     VerticalAlignment="Top"
                                     Width="20"
                                     Height="20"
                                     HorizontalAlignment="Right"
                                     Background="Transparent"
                                     Foreground="#ffffff"
                                     Margin="0 10 50 0"
                                     Cursor="Hand"
                                     MouseLeftButtonDown="MinimizeButton_Click" />
            <materialDesign:PackIcon Kind="WindowClose"
                                     VerticalAlignment="Top"
                                     Width="20"
                                     Height="20"
                                     HorizontalAlignment="Right"
                                     Background="Transparent"
                                     Foreground="#ffffff"
                                     Margin="0 10 10 0"
                                     Cursor="Hand"
                                     MouseLeftButtonDown="CloseButton_Click" />
        </Grid>

    </Grid>

</Window>