<UserControl x:Class="ChartRender.DisplaySkill"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ChartRender"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             mc:Ignorable="d"
             >
    <Grid>
        <!-- 设置行定义，第一行用于按钮区域，第二行用于图表区域，第三行用于显示最大值和最小值 -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 按钮区 -->
            <RowDefinition Height="*"/>
            <!-- 图表区 -->
            <RowDefinition Height="Auto"/>
            <!-- 文本区 -->
        </Grid.RowDefinitions>
        <!-- 页面标题区域 -->
        <TextBlock Text="技能分布分析" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10" Grid.Row="0"/>
        <!-- 图表区域 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧：饼状图 -->
            <lvc:PieChart Name="PieChart" Margin="10" Grid.Column="0" />

            <!-- 右侧：柱状图 -->
            <lvc:CartesianChart Name="BarChart" Margin="10" Grid.Column="1">
                <lvc:CartesianChart.AxisX>
                    <lvc:Axis Title="技能" />
                </lvc:CartesianChart.AxisX>
                <lvc:CartesianChart.AxisY>
                    <lvc:Axis Title="人数" />
                </lvc:CartesianChart.AxisY>
            </lvc:CartesianChart>
        </Grid>

        <!-- 显示最大值和最小值的区域 -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Center" Grid.Row="2" Margin="0,10,0,10">
            <TextBlock Text="" FontSize="16" Margin="5"/>
            <TextBlock x:Name="MaxValueText" FontSize="16" Margin="5"/>
            <TextBlock Text="" FontSize="16" Margin="5"/>
            <TextBlock x:Name="MinValueText" FontSize="16" Margin="5"/>
        </StackPanel>
    </Grid>
</UserControl>
