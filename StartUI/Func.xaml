<Window xmlns:FileRender="clr-namespace:FileRender;assembly=FileRender"  x:Class="StartUI.Func"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:StartUI" 
        mc:Ignorable="d"
        Title="Intelligent Resume Paring" 
        Height="750" 
        Width="1200"
        Icon="/Resources/Logo.jpg"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStartupLocation="CenterScreen">

    <Border Background="#3e3a65"
            CornerRadius="15">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Border Background="#343155"
                    CornerRadius="15 0 0 15"
                    Width="200"
                    HorizontalAlignment="Left">

                <StackPanel Orientation="Vertical">
                    <!--垂直排列-->
                    <Grid Height="50"
                          VerticalAlignment="Top"
                          Margin="0 30 0 0">

                        <Border Background="BlueViolet"
                                Height="30"
                                CornerRadius="4 0 0 4"
                                Width="6"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right" />

                        <StackPanel>
                            <TextBlock Text="INTELLIGENT"
                                       Foreground="#FFFFFF"
                                       FontFamily="Fonts/#Orbitron Medium"
                                       FontSize="15"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Margin="0 5 0 5"/>
                            <TextBlock Text="RESUME PARING"
                                       Foreground="#FFFFFF"
                                       FontFamily="Fonts/#Orbitron Medium"
                                       FontSize="15"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <Menu Height="auto"
                          Background="Transparent"
                          Margin="0 30 0 0">

                        <Menu.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </Menu.ItemsPanel>




                        <MenuItem Header="新增简历"
                                  Template="{StaticResource Menu_Template}"
                                  DragEnter="DragEnterFunc"
                                  Drop="DragDropFunc"
                                  AllowDrop="True"
                                  Click="OpenResumeUploadWindow">
                            <!-- 点击事件 -->
                            <MenuItem.Icon>
                                <TextBlock Text="&#xe60e;"/>
                            </MenuItem.Icon>
                        </MenuItem>



                        <MenuItem Header="搜索简历"
Template="{StaticResource Menu_SubMenu_Template}">
                            <MenuItem.Icon>
                                <TextBlock Text="&#xe606;"/>
                            </MenuItem.Icon>

                            <MenuItem Header="按导入日期查询"
        Template="{StaticResource Item_Template}" Click="SearchByDate_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xe669;"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="按文件名称查询"
        Template="{StaticResource Item_Template}" Click="SearchByName_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xe669;"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuItem>






                        <MenuItem Header="结果解析"
                              Template="{StaticResource Menu_SubMenu_Template}">
                            <MenuItem.Icon>
                                <TextBlock Text="&#xe605;"/>
                            </MenuItem.Icon>

                            <MenuItem Header="内容提取"
                                      Template="{StaticResource Item_Template}" Click="MenuItem_Click_Resume_Analysis">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xe669;"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="JSON"
                                      Template="{StaticResource Item_Template}" Click="MenuItem_Click_JSON">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xeba3;"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="CSV"
                                      Template="{StaticResource Item_Template}" Click="MenuItem_Click_CSV">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xeba2;"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="XML"
                                      Template="{StaticResource Item_Template}" Click="MenuItem_Click_XML">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xeba4;"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuItem>

                        <MenuItem Header="格式转换"
                              Template="{StaticResource Menu_Template }" Click="Button_Click_Format_Conversion">
                            <MenuItem.Icon>
                                <TextBlock Text="&#xe60a;"/>
                            </MenuItem.Icon>
                        </MenuItem>

                        <MenuItem Header="简历匹配"
                            Template="{StaticResource Menu_Template}">
                            <MenuItem.Icon>
                                <TextBlock Text="&#xe60d;"/>
                            </MenuItem.Icon>
                        </MenuItem>


                        <MenuItem Header="技能评估"
          Template="{StaticResource Menu_Template}">
                            <MenuItem.Icon>
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xe8a1;" />
                            </MenuItem.Icon>
                        </MenuItem>


                        <MenuItem Header="统计分析"
                              Template="{StaticResource Menu_Template}">
                            <MenuItem.Icon>
                                <TextBlock Text="&#xe60c;"/>
                            </MenuItem.Icon>
                        </MenuItem>

                        <MenuItem Header="报告生成"
                              Template="{StaticResource Menu_Template}" Click="TestClick">
                            <MenuItem.Icon>
                                <TextBlock Text="&#xe60b;"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </Menu>

                </StackPanel>
            </Border>

            <ListBox x:Name="FilesListBox" Margin="108,59,72,61" Grid.Column="1"/>

            <Border Grid.Column="1"
                    Background="Transparent"
                    CornerRadius="0 15 15 0"
                    MouseDown="Border_MouseDown">
                <Grid x:Name="Grid1">
                    <TextBlock Text="INTELLIGENT RESUME PARING"
                               Foreground="#525965"
                               FontFamily="Fonts/#Orbitron Medium"
                               FontSize="20"
                               VerticalAlignment="Bottom"
                               HorizontalAlignment="Right"
                               Margin="0 0 15 15"/>

                    <materialDesign:PackIcon Kind="WindowClose"
                                     VerticalAlignment="Top"
                                     Width="20"
                                     Height="20"
                                     HorizontalAlignment="Right"
                                     Background="Transparent"
                                     Foreground="#ffffff"
                                     Margin="0 25 25 0"/>
                    <Button Height="20"
                    Width="20"
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Top" 
                    Margin="0 25 25 0"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Click="Button_Click_Close"/>

                    <materialDesign:PackIcon x:Name="Max" 
                                     Kind="WindowMaximize"
                                     VerticalAlignment="Top"
                                     Width="20"
                                     Height="20"
                                     HorizontalAlignment="Right"
                                     Background="Transparent"
                                     Foreground="#ffffff"
                                     Margin="0 25 70 0"
                                     Visibility="Visible"/>
                    <materialDesign:PackIcon x:Name="Normal" 
                                     Kind="WindowRestore"
                                     VerticalAlignment="Top"
                                     Width="20"
                                     Height="20"
                                     HorizontalAlignment="Right"
                                     Background="Transparent"
                                     Foreground="#ffffff"
                                     Margin="0 25 70 0"
                                     Visibility="Collapsed"/>
                    <Button Height="20"
                    Width="20"
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Top" 
                    Margin="0 25 70 0"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Click="Button_Click_ChangeSize"/>

                    <materialDesign:PackIcon Kind="WindowMinimize"
                                     VerticalAlignment="Top"
                                     Width="20"
                                     Height="20"
                                     HorizontalAlignment="Right"
                                     Background="Transparent"
                                     Foreground="#ffffff"
                                     Margin="0 25 120 0"/>
                    <Button Height="20"
                    Width="20"
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Top" 
                    Margin="0 25 120 0"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Click="Button_Click_Min"/>

                    <ScrollViewer x:Name="InputAreaScrollViewer" 
                        HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  Margin="55" Visibility="Collapsed">
                        <TextBox x:Name="InputArea"
                        Foreground="#ffffff" 
                        FontSize="20"   
                        VerticalAlignment="Top" 
                        HorizontalAlignment="Left" 
                        Margin="0"
                        Width="800"
                        Height="600"
                        TextWrapping="Wrap"
                        TextAlignment="Left" 
                        IsReadOnly="True"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        VerticalContentAlignment="Top"
                                 Visibility="Collapsed"
                        />
                    </ScrollViewer>


                    <materialDesign:PackIcon x:Name="closeInputAreaIcon" Kind="WindowClose"
                         Width="20"
                         Height="20"
                         Background="Transparent"
                         Foreground="#ffffff" Margin="825,60,0,0" RenderTransformOrigin="1.535,-0.65"
                                             Visibility="Collapsed"/>

                    <Button x:Name="closeInputAreaButton" HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Width="30"
                            Height="30"
                            Margin="0,55,145,0"
                            Background="Transparent"
                            Foreground="White"
                            BorderBrush="Transparent"
                            RenderTransformOrigin="0.997,0.207" 
                            Visibility="Collapsed"
                            Click="closeInputAreaButton_Click"/>
                    <ScrollViewer x:Name="DocDisplayScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                  Margin="10 55 10 10"
                                  Visibility="Collapsed">
                        <FileRender:FileRender x:Name="DocDisplay"
                                               Margin="0"
                                               Background="White"
                                               Height="600"
                                               Width="900"
                                               Visibility="Collapsed"/>
                    </ScrollViewer>
                    <materialDesign:PackIcon x:Name="DocDisplayIcon" 
                        Kind="WindowClose"
                 VerticalAlignment="Top"
                 Width="20"
                 Height="20"
                 HorizontalAlignment="Right"
                 Background="Transparent"
                 Foreground="#ffffff"
                 Margin="0 75 40 0"
                                             Visibility="Collapsed"/>
                    <Button x:Name="DocDisplayButton" 
                            Height="20"
                        Width="20"
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Top" 
                        Margin="0 75 40 0"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Click="Button_Click_AddResumeClose"
                            Visibility="Collapsed"/>


                </Grid>
            </Border>

        </Grid>

    </Border>
</Window>
