<Window x:Class="StartUI.SubSuccess"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:StartUI"
        mc:Ignorable="d"
        Title="SubSuccess" 
        Height="200" 
        Width="400"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True">

    <!-- 使用 Border 包裹整个 Grid，并设置背景图片和圆角 -->
    <Border CornerRadius="15">
        <Border.Background>
            <ImageBrush ImageSource="/Resources/SubSuccess.jpg" Stretch="UniformToFill"/>
        </Border.Background>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.618*"/>
            </Grid.ColumnDefinitions>

            <!-- 左区域图标 -->
            <Border Background="#fdfdfd"
                    CornerRadius="100"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Height="100"
                    Width="100">
                <Grid>
                    <Ellipse Height="95"
                             Width="95"
                             StrokeThickness="5">
                        <Ellipse.Stroke>
                            <LinearGradientBrush>
                                <GradientStop Color="#e27c53" Offset="0.15"/>
                                <GradientStop Color="#dca530" Offset="0.2"/>
                                <GradientStop Color="#8bb356" Offset="0.3"/>
                                <GradientStop Color="#3bb799" Offset="0.4"/>
                                <GradientStop Color="#67cbee" Offset="0.5"/>
                                <GradientStop Color="#3699db" Offset="0.6"/>
                                <GradientStop Color="#9264aa" Offset="0.8"/>
                                <GradientStop Color="#6e94de" Offset="0.9"/>
                            </LinearGradientBrush>
                        </Ellipse.Stroke>
                    </Ellipse>

                    <materialDesign:PackIcon Kind="Tick"
                                             VerticalAlignment="Center"
                                             Width="85"
                                             Height="85"
                                             HorizontalAlignment="Center">
                        <materialDesign:PackIcon.Foreground>
                            <LinearGradientBrush>
                                <GradientStop Color="#e27c53" Offset="0.1"/>
                                <GradientStop Color="#dca530" Offset="0.3"/>
                                <GradientStop Color="#3bb799" Offset="0.5"/>
                                <GradientStop Color="#67cbee" Offset="0.7"/>
                                <GradientStop Color="#3699db" Offset="0.8"/>
                            </LinearGradientBrush>
                        </materialDesign:PackIcon.Foreground>
                    </materialDesign:PackIcon>
                </Grid>
            </Border>

            <!-- 右区域 -->
            <Border Grid.Column="1">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="Your account has been"
                               FontSize="20"
                               Foreground="#ffffff"
                               FontWeight="Light"
                               TextAlignment="Center"/>
                    <TextBlock Text="successfully registered."
                               FontSize="20"
                               Foreground="#ffffff"
                               FontWeight="Light"
                               TextAlignment="Center"/>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Bottom">
                        <TextBlock Text="Please return to login"
                                   FontSize="15"
                                   FontWeight="Light"
                                   Margin="0 20"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
