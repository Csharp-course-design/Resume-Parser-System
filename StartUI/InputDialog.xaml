<Window x:Class="YourNamespace.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Input Dialog" Height="150" Width="300">
    <Grid>
        <!-- 提示文本 -->
        <TextBlock x:Name="PromptTextBlock" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="10" />

        <!-- 输入框 -->
        <TextBox x:Name="InputTextBox" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="10" />

        <!-- 按钮 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="10">
            <Button Content="OK" Width="75" Click="OkButton_Click" />
            <Button Content="Cancel" Width="75" Margin="10,0,0,0" Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>