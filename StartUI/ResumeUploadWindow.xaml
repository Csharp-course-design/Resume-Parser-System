<Window x:Class="StartUI.ResumeUploadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新增简历" Height="200" Width="400"
        AllowDrop="True" DragEnter="Window_DragEnter" Drop="Window_Drop">
    <Grid>
        <!-- 文件拖放区域 -->
        <Border BorderBrush="Gray" BorderThickness="2" CornerRadius="5"
                Background="LightGray" Margin="20">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="将文件拖放到此处" FontSize="16" 
                           HorizontalAlignment="Center"/>
                <Button Content="点击添加文件" Width="150" Margin="10"
                        Click="SelectFileButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
