    <Resource Include="Resources\cn_synonym.txt" />
    <Resource Include="Resources\dict.txt" />
    <Resource Include="Resources\idf.txt" />
    <Resource Include="Resources\Licence.jpg" />
    <Resource Include="Resources\LoginLeft.jpg" />
    <Resource Include="Resources\Logo.jpg" />
    <Resource Include="Resources\pos_prob_emit.json" />
    <Resource Include="Resources\pos_prob_start.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\pos_prob_trans.json" />
